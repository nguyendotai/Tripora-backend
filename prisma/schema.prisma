generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum UserStatus {
  ACTIVE
  INACTIVE
  BANNED
}

model User {
  id            BigInt         @id @default(autoincrement())
  email         String         @unique
  passwordHash  String         @map("password_hash")
  firstName     String?        @map("first_name")
  lastName      String?        @map("last_name")
  avatar        String?        @map("avatar")
  role          Role           @default(USER)
  status        UserStatus     @default(ACTIVE)
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  deletedAt     DateTime?      @map("deleted_at")
  refreshTokens RefreshToken[]
  wishlistItems WishlistItem[]
  reviews       Review[]
  trips         Trip[]
  notifications Notification[]
  provider      Provider?
  bookings      HotelBooking[]

  @@map("users")
}

model RefreshToken {
  id        BigInt    @id @default(autoincrement())
  userId    BigInt    @map("user_id")
  tokenHash String    @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")
  user      User      @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("refresh_tokens")
}

model Destination {
  id          BigInt    @id @default(autoincrement())
  name        String
  slug        String    @unique
  country     String?
  description String?   @db.Text
  images      Json?
  tags        Json?
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  travelGuides  TravelGuide[]
  wishlistItems WishlistItem[]
  reviews       Review[]
  tripItems     TripItem[]
  properties    Property[]
  tours         Tour[]

  @@index([country])
  @@map("destinations")
}

model TravelGuide {
  id            BigInt    @id @default(autoincrement())
  title         String
  slug          String    @unique
  excerpt       String?
  content       String    @db.Text
  coverImage    String?   @map("cover_image")
  destinationId BigInt?   @map("destination_id")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  deletedAt     DateTime? @map("deleted_at")

  destination Destination? @relation(fields: [destinationId], references: [id])

  @@index([destinationId])
  @@map("travel_guides")
}

model WishlistItem {
  id            BigInt   @id @default(autoincrement())
  userId        BigInt   @map("user_id")
  destinationId BigInt   @map("destination_id")
  createdAt     DateTime @default(now()) @map("created_at")

  user        User        @relation(fields: [userId], references: [id])
  destination Destination @relation(fields: [destinationId], references: [id])

  @@unique([userId, destinationId])
  @@index([destinationId])
  @@map("wishlist_items")
}

model Review {
  id            BigInt    @id @default(autoincrement())
  userId        BigInt    @map("user_id")
  destinationId BigInt    @map("destination_id")
  rating        Int
  content       String?   @db.Text
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  deletedAt     DateTime? @map("deleted_at")

  user        User        @relation(fields: [userId], references: [id])
  destination Destination @relation(fields: [destinationId], references: [id])

  @@unique([userId, destinationId])
  @@index([destinationId])
  @@map("reviews")
}

model Trip {
  id        BigInt    @id @default(autoincrement())
  userId    BigInt    @map("user_id")
  title     String
  startDate DateTime? @map("start_date")
  endDate   DateTime? @map("end_date")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  user User      @relation(fields: [userId], references: [id])
  days TripDay[]

  @@index([userId])
  @@map("trips")
}

model TripDay {
  id        BigInt    @id @default(autoincrement())
  tripId    BigInt    @map("trip_id")
  dayNumber Int       @map("day_number")
  date      DateTime?
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  trip  Trip       @relation(fields: [tripId], references: [id], onDelete: Cascade)
  items TripItem[]

  @@unique([tripId, dayNumber])
  @@map("trip_days")
}

model TripItem {
  id            BigInt   @id @default(autoincrement())
  tripDayId     BigInt   @map("trip_day_id")
  destinationId BigInt?  @map("destination_id")
  title         String
  note          String?  @db.Text
  sortOrder     Int      @default(0) @map("sort_order")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  tripDay     TripDay      @relation(fields: [tripDayId], references: [id], onDelete: Cascade)
  destination Destination? @relation(fields: [destinationId], references: [id])

  @@index([tripDayId])
  @@map("trip_items")
}

model BlogPost {
  id          BigInt    @id @default(autoincrement())
  title       String
  slug        String    @unique
  excerpt     String?
  content     String    @db.Text
  coverImage  String?   @map("cover_image")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  @@map("blog_posts")
}

model Notification {
  id        BigInt   @id @default(autoincrement())
  userId    BigInt   @map("user_id")
  title     String
  message   String   @db.Text
  isRead    Boolean  @default(false) @map("is_read")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("notifications")
}

enum ProviderType {
  HOTEL
  TOUR
  ACTIVITY
  TRANSPORT
  FLIGHT
}

enum ProviderStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

// V2 scope: 1 User -> 1 Provider profile (chưa có Organization/multi-member).
// Sẽ mở rộng thành Organization ở V7 (xem business-rules Provider Marketplace).
model Provider {
  id          BigInt         @id @default(autoincrement())
  userId      BigInt         @unique @map("user_id")
  type        ProviderType   @default(HOTEL)
  name        String
  description String?        @db.Text
  logo        String?
  contact     String?
  status      ProviderStatus @default(PENDING)
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")

  user       User       @relation(fields: [userId], references: [id])
  properties Property[]
  tours      Tour[]

  @@map("providers")
}

enum PropertyStatus {
  PENDING
  APPROVED
  REJECTED
}

// V2 scope: chỉ Hotel (Property = khách sạn của 1 Provider). Room/Inventory ở phần sau.
model Property {
  id            BigInt         @id @default(autoincrement())
  providerId    BigInt         @map("provider_id")
  destinationId BigInt?        @map("destination_id")
  name          String
  slug          String         @unique
  description   String?        @db.Text
  address       String?
  latitude      Float?
  longitude     Float?
  images        Json?
  amenities     Json?
  checkInTime   String?        @map("check_in_time")
  checkOutTime  String?        @map("check_out_time")
  policies      String?        @db.Text
  status        PropertyStatus @default(PENDING)
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  deletedAt     DateTime?      @map("deleted_at")

  provider    Provider       @relation(fields: [providerId], references: [id])
  destination Destination?   @relation(fields: [destinationId], references: [id])
  rooms       Room[]
  bookings    HotelBooking[]

  @@index([providerId])
  @@index([destinationId])
  @@map("properties")
}

enum RoomStatus {
  ACTIVE
  INACTIVE
}

// Loại phòng của 1 Property. Gia/tồn kho theo ngày cụ thể nằm ở RoomInventory (phần sau).
model Room {
  id          BigInt     @id @default(autoincrement())
  propertyId  BigInt     @map("property_id")
  name        String
  description String?    @db.Text
  capacity    Int?
  beds        Json?
  basePrice   Decimal    @db.Decimal(10, 2) @map("base_price")
  currency    String     @default("VND")
  amenities   Json?
  images      Json?
  status      RoomStatus @default(ACTIVE)
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")
  deletedAt   DateTime?  @map("deleted_at")

  property  Property        @relation(fields: [propertyId], references: [id])
  inventory RoomInventory[]
  bookings  HotelBooking[]

  @@index([propertyId])
  @@map("property_rooms")
}

// Ton kho + gia theo tung ngay cu the cua 1 Room. HotelBooking tru availableRooms
// atomic qua raw UPDATE ... WHERE available_rooms >= 1 (xem BookingRepository).
model RoomInventory {
  id             BigInt   @id @default(autoincrement())
  roomId         BigInt   @map("room_id")
  date           DateTime @db.Date
  totalRooms     Int      @map("total_rooms")
  availableRooms Int      @map("available_rooms")
  bookedRooms    Int      @default(0) @map("booked_rooms")
  price          Decimal? @db.Decimal(10, 2)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  room Room @relation(fields: [roomId], references: [id])

  @@unique([roomId, date])
  @@index([roomId])
  @@map("room_inventory")
}

enum BookingStatus {
  CONFIRMED
  CANCELLED
}

// Snapshot propertyName/roomName/totalPrice tai thoi diem dat — khong bao gio join
// nguoc lay gia hien thi (dung theo backend/CLAUDE.md muc 3 "Booking Snapshot").
model HotelBooking {
  id            BigInt        @id @default(autoincrement())
  userId        BigInt        @map("user_id")
  roomId        BigInt        @map("room_id")
  propertyId    BigInt        @map("property_id")
  propertyName  String        @map("property_name")
  roomName      String        @map("room_name")
  checkInDate   DateTime      @db.Date @map("check_in_date")
  checkOutDate  DateTime      @db.Date @map("check_out_date")
  nights        Int
  totalPrice    Decimal       @db.Decimal(10, 2) @map("total_price")
  currency      String        @default("VND")
  status        BookingStatus @default(CONFIRMED)
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  user     User     @relation(fields: [userId], references: [id])
  room     Room     @relation(fields: [roomId], references: [id])
  property Property @relation(fields: [propertyId], references: [id])
  guests   Guest[]

  @@index([userId])
  @@index([roomId])
  @@map("hotel_bookings")
}

model Guest {
  id        BigInt   @id @default(autoincrement())
  bookingId BigInt   @map("booking_id")
  fullName  String   @map("full_name")
  email     String?
  phone     String?
  createdAt DateTime @default(now()) @map("created_at")

  booking HotelBooking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
  @@map("guests")
}

enum TourStatus {
  PENDING
  APPROVED
  REJECTED
}

// V3 scope: Tour = tour du lịch của 1 Provider có type=TOUR (tái dùng Provider/ProviderStatus
// đã có từ V2, chỉ khác type — cùng luồng apply/duyệt, không tạo entity Tour Operator riêng).
// Itinerary/Schedule/Guide/Booking cho Tour sẽ thêm ở các vòng V3 sau.
model Tour {
  id                 BigInt     @id @default(autoincrement())
  providerId         BigInt     @map("provider_id")
  destinationId      BigInt?    @map("destination_id")
  title              String
  slug               String     @unique
  description        String?    @db.Text
  images             Json?
  durationLabel      String?    @map("duration_label")
  price              Decimal    @db.Decimal(10, 2)
  currency           String     @default("VND")
  maxParticipants    Int?       @map("max_participants")
  included           String?    @db.Text
  excluded           String?    @db.Text
  cancellationPolicy String?    @db.Text @map("cancellation_policy")
  status             TourStatus @default(PENDING)
  createdAt          DateTime   @default(now()) @map("created_at")
  updatedAt          DateTime   @updatedAt @map("updated_at")
  deletedAt          DateTime?  @map("deleted_at")

  provider    Provider        @relation(fields: [providerId], references: [id])
  destination Destination?    @relation(fields: [destinationId], references: [id])
  itineraries TourItinerary[]

  @@index([providerId])
  @@index([destinationId])
  @@map("tours")
}

// Lich trinh theo ngay cua 1 Tour — khong co status rieng, an/hien theo Tour cha (giong Room theo Property).
// Hard delete (khong soft-delete) — giong TripDay: khong entity nao tham chieu nguoc 1 ngay lich trinh,
// va dayNumber tu tang dua tren ngay con lai nen soft-delete se dam vao unique(tourId, dayNumber) cua ban ghi cu.
model TourItinerary {
  id         BigInt   @id @default(autoincrement())
  tourId     BigInt   @map("tour_id")
  dayNumber  Int      @map("day_number")
  title      String
  activities String?  @db.Text
  meals      String?  @db.Text
  locations  String?  @db.Text
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  tour Tour @relation(fields: [tourId], references: [id])

  @@unique([tourId, dayNumber])
  @@index([tourId])
  @@map("tour_itineraries")
}
