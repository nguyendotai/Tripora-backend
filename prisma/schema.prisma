generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum UserStatus {
  ACTIVE
  INACTIVE
  BANNED
}

model User {
  id                 BigInt              @id @default(autoincrement())
  email              String              @unique
  passwordHash       String              @map("password_hash")
  firstName          String?             @map("first_name")
  lastName           String?             @map("last_name")
  avatar             String?             @map("avatar")
  role               Role                @default(USER)
  status             UserStatus          @default(ACTIVE)
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")
  deletedAt          DateTime?           @map("deleted_at")
  refreshTokens      RefreshToken[]
  wishlistItems      WishlistItem[]
  reviews            Review[]
  trips              Trip[]
  notifications      Notification[]
  provider           Provider?
  organizationMember OrganizationMember?
  tourGuide          TourGuide?
  bookings           HotelBooking[]
  tourBookings       TourBooking[]
  experienceBookings ExperienceBooking[]
  transportBookings  TransportBooking[]
  flightBookings     FlightBooking[]
  payments           Payment[]
  invoices           Invoice[]
  couponRedemptions  CouponRedemption[]
  refunds            Refund[]
  posts              Post[]
  likes              Like[]
  savedPosts         SavedPost[]
  following          Follow[]            @relation("Follower")
  followers          Follow[]            @relation("Following")
  comments           Comment[]
  conversations      Conversation[]
  sentMessages       Message[]

  @@map("users")
}

model RefreshToken {
  id        BigInt    @id @default(autoincrement())
  userId    BigInt    @map("user_id")
  tokenHash String    @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")
  user      User      @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("refresh_tokens")
}

model Destination {
  id          BigInt    @id @default(autoincrement())
  name        String
  slug        String    @unique
  country     String?
  description String?   @db.Text
  images      Json?
  tags        Json?
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  travelGuides  TravelGuide[]
  wishlistItems WishlistItem[]
  reviews       Review[]
  tripItems     TripItem[]
  properties    Property[]
  tours         Tour[]
  experiences   Experience[]
  posts         Post[]

  @@index([country])
  @@map("destinations")
}

model TravelGuide {
  id            BigInt    @id @default(autoincrement())
  title         String
  slug          String    @unique
  excerpt       String?
  content       String    @db.Text
  coverImage    String?   @map("cover_image")
  destinationId BigInt?   @map("destination_id")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  deletedAt     DateTime? @map("deleted_at")

  destination Destination? @relation(fields: [destinationId], references: [id])

  @@index([destinationId])
  @@map("travel_guides")
}

model WishlistItem {
  id            BigInt   @id @default(autoincrement())
  userId        BigInt   @map("user_id")
  destinationId BigInt   @map("destination_id")
  createdAt     DateTime @default(now()) @map("created_at")

  user        User        @relation(fields: [userId], references: [id])
  destination Destination @relation(fields: [destinationId], references: [id])

  @@unique([userId, destinationId])
  @@index([destinationId])
  @@map("wishlist_items")
}

// V7 vong 9 — destinationId thanh optional + them propertyId optional de Review gan duoc voi
// san pham Provider ban, khong chi Destination. MySQL cho phep nhieu NULL trong unique index nen
// review Destination cu khong doi hanh vi. Dung dung 1 trong 2 (XOR, validate o Service).
model Review {
  id            BigInt    @id @default(autoincrement())
  userId        BigInt    @map("user_id")
  destinationId BigInt?   @map("destination_id")
  propertyId    BigInt?   @map("property_id")
  rating        Int
  content       String?   @db.Text
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  deletedAt     DateTime? @map("deleted_at")

  user        User         @relation(fields: [userId], references: [id])
  destination Destination? @relation(fields: [destinationId], references: [id])
  property    Property?    @relation(fields: [propertyId], references: [id])

  @@unique([userId, destinationId])
  @@unique([userId, propertyId])
  @@index([destinationId])
  @@index([propertyId])
  @@map("reviews")
}

model Trip {
  id        BigInt    @id @default(autoincrement())
  userId    BigInt    @map("user_id")
  title     String
  startDate DateTime? @map("start_date")
  endDate   DateTime? @map("end_date")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  user User      @relation(fields: [userId], references: [id])
  days TripDay[]

  @@index([userId])
  @@map("trips")
}

model TripDay {
  id        BigInt    @id @default(autoincrement())
  tripId    BigInt    @map("trip_id")
  dayNumber Int       @map("day_number")
  date      DateTime?
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  trip  Trip       @relation(fields: [tripId], references: [id], onDelete: Cascade)
  items TripItem[]

  @@unique([tripId, dayNumber])
  @@map("trip_days")
}

model TripItem {
  id            BigInt   @id @default(autoincrement())
  tripDayId     BigInt   @map("trip_day_id")
  destinationId BigInt?  @map("destination_id")
  title         String
  note          String?  @db.Text
  sortOrder     Int      @default(0) @map("sort_order")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  tripDay     TripDay      @relation(fields: [tripDayId], references: [id], onDelete: Cascade)
  destination Destination? @relation(fields: [destinationId], references: [id])

  @@index([tripDayId])
  @@map("trip_items")
}

model BlogPost {
  id         BigInt    @id @default(autoincrement())
  title      String
  slug       String    @unique
  excerpt    String?
  content    String    @db.Text
  coverImage String?   @map("cover_image")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  deletedAt  DateTime? @map("deleted_at")

  @@map("blog_posts")
}

model Notification {
  id        BigInt   @id @default(autoincrement())
  userId    BigInt   @map("user_id")
  title     String
  message   String   @db.Text
  isRead    Boolean  @default(false) @map("is_read")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("notifications")
}

// V9 vong 3 — 1 Conversation/cap (userId, providerId), tai dung lai giua cac san pham khac nhau
// cua cung 1 Provider thay vi tao moi theo tung booking. Khong track read-state rieng tung nhan
// vien Provider — ca to chuc la 1 inbox chung, xem Message.isRead.
model Conversation {
  id            BigInt   @id @default(autoincrement())
  userId        BigInt   @map("user_id")
  providerId    BigInt   @map("provider_id")
  lastMessageAt DateTime @default(now()) @map("last_message_at")
  createdAt     DateTime @default(now()) @map("created_at")

  user     User      @relation(fields: [userId], references: [id])
  provider Provider  @relation(fields: [providerId], references: [id])
  messages Message[]

  @@unique([userId, providerId])
  @@index([providerId])
  @@map("conversations")
}

// isRead = da duoc phia con lai doc (khong phai per-staff) — "unread cho Traveler" la message co
// senderId khac conversation.userId va isRead=false, "unread cho Provider" la nguoc lai.
model Message {
  id             BigInt   @id @default(autoincrement())
  conversationId BigInt   @map("conversation_id")
  senderId       BigInt   @map("sender_id")
  content        String   @db.Text
  isRead         Boolean  @default(false) @map("is_read")
  createdAt      DateTime @default(now()) @map("created_at")

  conversation Conversation @relation(fields: [conversationId], references: [id])
  sender       User         @relation(fields: [senderId], references: [id])

  @@index([conversationId])
  @@map("messages")
}

enum AnalyticsEventType {
  SEARCH
  VIEW
}

// V9 vong 4 — khong co Prisma relation/FK toi User hay entity (tham chieu polymorphic qua
// entityType+entityId, mirror dung cach Payment.bookingDomain+bookingId da lam) vi entity co the
// la Property/Tour/Experience/Destination... khac nhau. userId null = khach an danh.
model AnalyticsEvent {
  id         BigInt             @id @default(autoincrement())
  type       AnalyticsEventType
  userId     BigInt?            @map("user_id")
  entityType String?            @map("entity_type")
  entityId   BigInt?            @map("entity_id")
  query      String?
  createdAt  DateTime           @default(now()) @map("created_at")

  @@index([type, createdAt])
  @@index([userId])
  @@map("analytics_events")
}

// Audit log cho cac action nhay cam (review/suspend/xoa moderation/doi commission rate...).
// Polymorphic (entityType+entityId, khong @relation) vi entity co the la Property/Provider/
// Comment/User... khac nhau, mirror dung cach AnalyticsEvent da lam.
model ActivityLog {
  id         BigInt   @id @default(autoincrement())
  actorId    BigInt   @map("actor_id")
  actorRole  String   @map("actor_role")
  action     String
  entityType String   @map("entity_type")
  entityId   BigInt   @map("entity_id")
  reason     String?  @db.Text
  metadata   Json?
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([entityType, entityId])
  @@index([actorId])
  @@index([createdAt])
  @@map("activity_logs")
}

enum ProviderType {
  HOTEL
  TOUR
  ACTIVITY
  TRANSPORT
  FLIGHT
}

enum ProviderStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

// V2: Provider.userId la nguoi nop ho so goc. Tu V7 vong 1, quyen thao tac thuc te
// di qua OrganizationMember (nhieu nhan su/role trong 1 Provider) thay vi userId 1:1 nay —
// Provider.userId van giu lai chi de biet "ai la nguoi nop ho so ban dau", khong con la
// nguon xac thuc quyen han duy nhat. Khong doi ten bang/cot sang Organization (xem CHANGELOG
// vong 1 — rename thuan tuy, khong tang gia tri chuc nang).
model Provider {
  id             BigInt         @id @default(autoincrement())
  userId         BigInt         @unique @map("user_id")
  type           ProviderType   @default(HOTEL)
  name           String
  description    String?        @db.Text
  logo           String?
  contact        String?
  // Mang URL tai lieu kinh doanh (giay phep, chung chi...) upload luc apply — cung co che voi
  // Property.images/Tour.images, khong query/filter rieng nen dung JSON thay vi bang con.
  documents      Json?
  status         ProviderStatus @default(PENDING)
  // Ty le hoa hong Platform an tren moi Booking CONFIRMED cua Provider nay (0.1000 = 10%).
  // Chinh qua PATCH /providers/:id/commission-rate (ADMIN) — moi Provider co the khac nhau.
  commissionRate Decimal        @default(0.1) @map("commission_rate") @db.Decimal(5, 4)
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  user                User                 @relation(fields: [userId], references: [id])
  organizationMembers OrganizationMember[]
  properties          Property[]
  tours               Tour[]
  experiences         Experience[]
  tourGuides          TourGuide[]
  vehicles            Vehicle[]
  transportRoutes     TransportRoute[]
  drivers             Driver[]
  aircrafts           Aircraft[]
  flights             Flight[]
  commissions         Commission[]
  promotions          Promotion[]
  conversations       Conversation[]

  @@map("providers")
}

enum OrgMemberRole {
  OWNER
  MANAGER
  BOOKING_STAFF
  FINANCE_STAFF
}

// V7 vong 1 — RBAC/multi-tenant. Thay the Provider.userId 1:1 cu lam nguon xac thuc quyen han.
// 1 User toi da 1 membership TOAN HE THONG (userId @unique) — mirror TourGuide.userId, tranh
// phai lam "active organization" selector cho vong 1 (V7 DoD khong yeu cau 1 nguoi thuoc nhieu
// to chuc). Hard delete khi remove — cung ly do TourGuide (soft-delete tung gay bug unique
// constraint khi tao lai).
model OrganizationMember {
  id         BigInt        @id @default(autoincrement())
  providerId BigInt        @map("provider_id")
  userId     BigInt        @unique @map("user_id")
  role       OrgMemberRole
  createdAt  DateTime      @default(now()) @map("created_at")

  provider Provider @relation(fields: [providerId], references: [id])
  user     User     @relation(fields: [userId], references: [id])

  @@index([providerId])
  @@map("organization_members")
}

enum PropertyStatus {
  PENDING
  APPROVED
  REJECTED
}

// V2 scope: chỉ Hotel (Property = khách sạn của 1 Provider). Room/Inventory ở phần sau.
model Property {
  id            BigInt         @id @default(autoincrement())
  providerId    BigInt         @map("provider_id")
  destinationId BigInt?        @map("destination_id")
  name          String
  slug          String         @unique
  description   String?        @db.Text
  address       String?
  latitude      Float?
  longitude     Float?
  images        Json?
  amenities     Json?
  checkInTime   String?        @map("check_in_time")
  checkOutTime  String?        @map("check_out_time")
  policies      String?        @db.Text
  status        PropertyStatus @default(PENDING)
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  deletedAt     DateTime?      @map("deleted_at")

  provider    Provider       @relation(fields: [providerId], references: [id])
  destination Destination?   @relation(fields: [destinationId], references: [id])
  rooms       Room[]
  bookings    HotelBooking[]
  reviews     Review[]

  @@index([providerId])
  @@index([destinationId])
  @@map("properties")
}

enum RoomStatus {
  ACTIVE
  INACTIVE
}

// Loại phòng của 1 Property. Gia/tồn kho theo ngày cụ thể nằm ở RoomInventory (phần sau).
model Room {
  id          BigInt     @id @default(autoincrement())
  propertyId  BigInt     @map("property_id")
  name        String
  description String?    @db.Text
  capacity    Int?
  beds        Json?
  basePrice   Decimal    @map("base_price") @db.Decimal(10, 2)
  currency    String     @default("VND")
  amenities   Json?
  images      Json?
  status      RoomStatus @default(ACTIVE)
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")
  deletedAt   DateTime?  @map("deleted_at")

  property  Property        @relation(fields: [propertyId], references: [id])
  inventory RoomInventory[]
  bookings  HotelBooking[]

  @@index([propertyId])
  @@map("property_rooms")
}

// Ton kho + gia theo tung ngay cu the cua 1 Room. HotelBooking tru availableRooms
// atomic qua raw UPDATE ... WHERE available_rooms >= 1 (xem BookingRepository).
model RoomInventory {
  id             BigInt   @id @default(autoincrement())
  roomId         BigInt   @map("room_id")
  date           DateTime @db.Date
  totalRooms     Int      @map("total_rooms")
  availableRooms Int      @map("available_rooms")
  bookedRooms    Int      @default(0) @map("booked_rooms")
  price          Decimal? @db.Decimal(10, 2)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  room Room @relation(fields: [roomId], references: [id])

  @@unique([roomId, date])
  @@index([roomId])
  @@map("room_inventory")
}

// V6 mo rong tu 2 gia tri (CONFIRMED/CANCELLED) — dung chung cho ca 5 bang Booking
// (Hotel/Tour/Experience/Transport/Flight), chi 1 cho sua schema ap dung cho ca 5.
// State machine: PENDING_PAYMENT -> PAID -> CONFIRMED -> COMPLETED, hoac
// PENDING_PAYMENT -> EXPIRED, hoac CONFIRMED -> CANCELLED -> REFUND_PENDING -> REFUNDED.
enum BookingStatus {
  PENDING_PAYMENT
  PAID
  CONFIRMED
  COMPLETED
  EXPIRED
  CANCELLED
  REFUND_PENDING
  REFUNDED
}

// Snapshot propertyName/roomName/totalPrice tai thoi diem dat — khong bao gio join
// nguoc lay gia hien thi (dung theo backend/CLAUDE.md muc 3 "Booking Snapshot").
model HotelBooking {
  id           BigInt        @id @default(autoincrement())
  userId       BigInt        @map("user_id")
  roomId       BigInt        @map("room_id")
  propertyId   BigInt        @map("property_id")
  propertyName String        @map("property_name")
  roomName     String        @map("room_name")
  checkInDate  DateTime      @map("check_in_date") @db.Date
  checkOutDate DateTime      @map("check_out_date") @db.Date
  nights       Int
  totalPrice   Decimal       @map("total_price") @db.Decimal(10, 2)
  currency     String        @default("VND")
  status       BookingStatus @default(PENDING_PAYMENT)
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  user     User     @relation(fields: [userId], references: [id])
  room     Room     @relation(fields: [roomId], references: [id])
  property Property @relation(fields: [propertyId], references: [id])
  guests   Guest[]

  @@index([userId])
  @@index([roomId])
  @@map("hotel_bookings")
}

model Guest {
  id        BigInt   @id @default(autoincrement())
  bookingId BigInt   @map("booking_id")
  fullName  String   @map("full_name")
  email     String?
  phone     String?
  createdAt DateTime @default(now()) @map("created_at")

  booking HotelBooking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
  @@map("guests")
}

enum TourStatus {
  PENDING
  APPROVED
  REJECTED
}

// V3 scope: Tour = tour du lịch của 1 Provider có type=TOUR (tái dùng Provider/ProviderStatus
// đã có từ V2, chỉ khác type — cùng luồng apply/duyệt, không tạo entity Tour Operator riêng).
// Itinerary/Schedule/Guide/Booking cho Tour sẽ thêm ở các vòng V3 sau.
model Tour {
  id                 BigInt     @id @default(autoincrement())
  providerId         BigInt     @map("provider_id")
  destinationId      BigInt?    @map("destination_id")
  title              String
  slug               String     @unique
  description        String?    @db.Text
  images             Json?
  durationLabel      String?    @map("duration_label")
  price              Decimal    @db.Decimal(10, 2)
  currency           String     @default("VND")
  maxParticipants    Int?       @map("max_participants")
  included           String?    @db.Text
  excluded           String?    @db.Text
  cancellationPolicy String?    @map("cancellation_policy") @db.Text
  status             TourStatus @default(PENDING)
  createdAt          DateTime   @default(now()) @map("created_at")
  updatedAt          DateTime   @updatedAt @map("updated_at")
  deletedAt          DateTime?  @map("deleted_at")

  provider    Provider        @relation(fields: [providerId], references: [id])
  destination Destination?    @relation(fields: [destinationId], references: [id])
  itineraries TourItinerary[]
  schedules   TourSchedule[]
  bookings    TourBooking[]

  @@index([providerId])
  @@index([destinationId])
  @@map("tours")
}

// Ngay khoi hanh cua 1 Tour, kem suc chua — cung mo hinh 3 cot total/available/booked
// nhu RoomInventory (V2), de san sang cho decrement atomic khi lam Tour Booking (vong sau):
// UPDATE tour_schedules SET available = available - :qty, booked = booked + :qty WHERE ... AND available >= :qty.
model TourSchedule {
  id            BigInt   @id @default(autoincrement())
  tourId        BigInt   @map("tour_id")
  departureDate DateTime @map("departure_date") @db.Date
  capacity      Int
  available     Int
  booked        Int      @default(0)
  price         Decimal? @db.Decimal(10, 2)
  guideId       BigInt?  @map("guide_id")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  tour  Tour       @relation(fields: [tourId], references: [id])
  guide TourGuide? @relation(fields: [guideId], references: [id])

  @@unique([tourId, departureDate])
  @@index([tourId])
  @@index([guideId])
  @@map("tour_schedules")
}

// Guide van la Role.USER (khong them Role enum/bang roles-permissions moi, dung tinh than
// backend/CLAUDE.md muc 4 "khong tao bang roles/permissions chi tiet truoc khi can") — chi la 1 profile
// TourGuide gan voi 1 User da dang ky san, do Tour Operator tao (nhap email User co san, khong co luong
// tu apply nhu Provider vi Guide la "nhan vien" cua Operator chu khong tu dang ky). 1 User toi da 1 ho so
// Guide (userId unique), thuoc dung 1 Tour Operator — chua ho tro 1 Guide lam cho nhieu Operator.
// Hard delete (khong soft-delete) — cung ly do da doi TourItinerary sang hard delete o vong truoc:
// unique(userId) cua MySQL van tinh ca ban ghi soft-delete, khien xoa roi them lai cung email bi loi
// unique constraint that 500 thay vi tao lai duoc. Khong bang nao tham chieu nguoc TourGuide can giu
// lich su (TourSchedule.guideId duoc go ve null truoc khi xoa — xem TourGuideService.remove).
model TourGuide {
  id         BigInt          @id @default(autoincrement())
  providerId BigInt          @map("provider_id")
  userId     BigInt          @unique @map("user_id")
  bio        String?         @db.Text
  phone      String?
  status     TourGuideStatus @default(ACTIVE)
  createdAt  DateTime        @default(now()) @map("created_at")
  updatedAt  DateTime        @updatedAt @map("updated_at")

  provider  Provider       @relation(fields: [providerId], references: [id])
  user      User           @relation(fields: [userId], references: [id])
  schedules TourSchedule[]

  @@index([providerId])
  @@map("tour_guides")
}

enum TourGuideStatus {
  ACTIVE
  INACTIVE
}

// Lich trinh theo ngay cua 1 Tour — khong co status rieng, an/hien theo Tour cha (giong Room theo Property).
// Hard delete (khong soft-delete) — giong TripDay: khong entity nao tham chieu nguoc 1 ngay lich trinh,
// va dayNumber tu tang dua tren ngay con lai nen soft-delete se dam vao unique(tourId, dayNumber) cua ban ghi cu.
model TourItinerary {
  id         BigInt   @id @default(autoincrement())
  tourId     BigInt   @map("tour_id")
  dayNumber  Int      @map("day_number")
  title      String
  activities String?  @db.Text
  meals      String?  @db.Text
  locations  String?  @db.Text
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  tour Tour @relation(fields: [tourId], references: [id])

  @@unique([tourId, dayNumber])
  @@index([tourId])
  @@map("tour_itineraries")
}

// Tour Booking — 1 khach hang dat N cho cho 1 ngay khoi hanh cu the (khac Hotel Booking dat theo
// khoang ngay + danh sach Guest co ten). "Customer Info" o day la 1 nguoi lien he duy nhat, khong
// phai danh sach khach nhu Guest cua Hotel — dung theo dung wording checklist "Number of People ->
// Customer Info". Tai su dung BookingStatus da co (CONFIRMED/CANCELLED) thay vi tao enum rieng.
model TourBooking {
  id             BigInt        @id @default(autoincrement())
  userId         BigInt        @map("user_id")
  tourId         BigInt        @map("tour_id")
  tourTitle      String        @map("tour_title")
  departureDate  DateTime      @map("departure_date") @db.Date
  numberOfPeople Int           @map("number_of_people")
  customerName   String        @map("customer_name")
  customerEmail  String?       @map("customer_email")
  customerPhone  String?       @map("customer_phone")
  totalPrice     Decimal       @map("total_price") @db.Decimal(10, 2)
  currency       String        @default("VND")
  status         BookingStatus @default(PENDING_PAYMENT)
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id])
  tour Tour @relation(fields: [tourId], references: [id])

  @@index([userId])
  @@index([tourId])
  @@map("tour_bookings")
}

enum ExperienceStatus {
  PENDING
  APPROVED
  REJECTED
}

// V3 scope: Experience = hoat dong ngan (ve tham quan, lop hoc, trai nghiem 1 buoi...) cua 1 Provider
// type=ACTIVITY (ProviderType.ACTIVITY co san tu V2, chua dung toi — cung cach tai dung Provider da
// ap dung cho Tour Operator type=TOUR). Quy mo nho hon Tour co chu dich: khong co Itinerary rieng
// (1 buoi/ngay, khong can chia lich trinh nhieu ngay).
model Experience {
  id                 BigInt           @id @default(autoincrement())
  providerId         BigInt           @map("provider_id")
  destinationId      BigInt?          @map("destination_id")
  title              String
  slug               String           @unique
  description        String?          @db.Text
  images             Json?
  durationLabel      String?          @map("duration_label")
  price              Decimal          @db.Decimal(10, 2)
  currency           String           @default("VND")
  maxParticipants    Int?             @map("max_participants")
  included           String?          @db.Text
  excluded           String?          @db.Text
  cancellationPolicy String?          @map("cancellation_policy") @db.Text
  status             ExperienceStatus @default(PENDING)
  createdAt          DateTime         @default(now()) @map("created_at")
  updatedAt          DateTime         @updatedAt @map("updated_at")
  deletedAt          DateTime?        @map("deleted_at")

  provider    Provider             @relation(fields: [providerId], references: [id])
  destination Destination?         @relation(fields: [destinationId], references: [id])
  schedules   ExperienceSchedule[]
  bookings    ExperienceBooking[]

  @@index([providerId])
  @@index([destinationId])
  @@map("experiences")
}

// Mirror TourSchedule y het — bulk-set theo khoang ngay, 3 cot capacity/available/booked de
// decrement atomic o ExperienceBooking dung pattern backend/CLAUDE.md muc 3.
model ExperienceSchedule {
  id            BigInt   @id @default(autoincrement())
  experienceId  BigInt   @map("experience_id")
  departureDate DateTime @map("departure_date") @db.Date
  capacity      Int
  available     Int
  booked        Int      @default(0)
  price         Decimal? @db.Decimal(10, 2)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  experience Experience @relation(fields: [experienceId], references: [id])

  @@unique([experienceId, departureDate])
  @@index([experienceId])
  @@map("experience_schedules")
}

// Mirror TourBooking y het — 1 nguoi lien he + numberOfPeople, khong phai danh sach Guest co ten.
model ExperienceBooking {
  id              BigInt        @id @default(autoincrement())
  userId          BigInt        @map("user_id")
  experienceId    BigInt        @map("experience_id")
  experienceTitle String        @map("experience_title")
  departureDate   DateTime      @map("departure_date") @db.Date
  numberOfPeople  Int           @map("number_of_people")
  customerName    String        @map("customer_name")
  customerEmail   String?       @map("customer_email")
  customerPhone   String?       @map("customer_phone")
  totalPrice      Decimal       @map("total_price") @db.Decimal(10, 2)
  currency        String        @default("VND")
  status          BookingStatus @default(PENDING_PAYMENT)
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  user       User       @relation(fields: [userId], references: [id])
  experience Experience @relation(fields: [experienceId], references: [id])

  @@index([userId])
  @@index([experienceId])
  @@map("experience_bookings")
}

enum VehicleType {
  CAR
  SUV
  VAN
  BUS
  MOTORBIKE
}

enum VehicleStatus {
  PENDING
  APPROVED
  REJECTED
}

// V4 mo dau — tai dung Provider (ProviderType.TRANSPORT, da co san tu schema V2 nhung chua dung)
// dung pattern voi Tour/Experience o V3, khong tao entity "Transportation Company" rieng.
// Mirror Tour/Property: entity cap cao nhat (providerId truc tiep, khong long duoi entity khac)
// nen can Admin duyet (PENDING/APPROVED/REJECTED) truoc khi hien cong khai, giong Property/Tour/
// Experience — khac Room la entity con cua Property nen chi can ACTIVE/INACTIVE.
model Vehicle {
  id           BigInt        @id @default(autoincrement())
  providerId   BigInt        @map("provider_id")
  type         VehicleType
  name         String
  model        String?
  capacity     Int
  features     Json?
  licensePlate String        @unique @map("license_plate")
  images       Json?
  status       VehicleStatus @default(PENDING)
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")
  deletedAt    DateTime?     @map("deleted_at")

  provider  Provider            @relation(fields: [providerId], references: [id])
  schedules TransportSchedule[]
  bookings  TransportBooking[]

  @@index([providerId])
  @@map("vehicles")
}

enum TransportRouteStatus {
  PENDING
  APPROVED
  REJECTED
}

// Hạng mục thứ 2 Backend V4 — "Transport Route/Schedule: CRUD" gộp chung 1 bullet checklist
// (workflow_and_database.md mục 13 chỉ liệt kê tên transport_routes/transport_schedules, không có
// field schema chi tiết — tự thiết kế mirror Tour/TourSchedule). Route là entity cấp cao nhất
// (providerId trực tiếp) nên cần Admin duyệt trước khi hiện công khai, giống Vehicle/Tour/Property —
// đúng luồng Frontend "Select Transport → Pickup → Drop-off" tức khách tìm Route theo origin/destination
// trước, chọn Vehicle sau (Vehicle không gắn cứng vào Route).
model TransportRoute {
  id                BigInt               @id @default(autoincrement())
  providerId        BigInt               @map("provider_id")
  origin            String
  destination       String
  vehicleType       VehicleType?         @map("vehicle_type")
  price             Decimal              @db.Decimal(10, 2)
  currency          String               @default("VND")
  estimatedDuration String?              @map("estimated_duration")
  status            TransportRouteStatus @default(PENDING)
  createdAt         DateTime             @default(now()) @map("created_at")
  updatedAt         DateTime             @updatedAt @map("updated_at")
  deletedAt         DateTime?            @map("deleted_at")

  provider  Provider            @relation(fields: [providerId], references: [id])
  schedules TransportSchedule[]
  bookings  TransportBooking[]

  @@index([providerId])
  @@map("transport_routes")
}

// Mirror TourSchedule (bulk-set theo khoảng ngày, 3 cột capacity/available/booked sẵn sàng cho
// decrement atomic ở Transport Booking vòng sau) — thêm vehicleId vì 1 Route có thể chạy bằng nhiều
// Vehicle khác nhau tuỳ ngày, khác Tour chỉ có đúng 1 "sản phẩm". vehicleId phải thuộc cùng Provider
// với routeId (kiểm tra ở Service, không phải composite FK).
model TransportSchedule {
  id            BigInt   @id @default(autoincrement())
  routeId       BigInt   @map("route_id")
  vehicleId     BigInt   @map("vehicle_id")
  departureDate DateTime @map("departure_date") @db.Date
  capacity      Int
  available     Int
  booked        Int      @default(0)
  price         Decimal? @db.Decimal(10, 2)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  route   TransportRoute @relation(fields: [routeId], references: [id])
  vehicle Vehicle        @relation(fields: [vehicleId], references: [id])

  @@unique([routeId, vehicleId, departureDate])
  @@index([routeId])
  @@index([vehicleId])
  @@map("transport_schedules")
}

// Mirror TourBooking gần như nguyên vẹn (1 người liên hệ + numberOfPeople, không phải Guest list như
// HotelBooking, tái dùng BookingStatus có sẵn) — khác biệt duy nhất là thêm vehicleId vì
// TransportSchedule dùng composite key [routeId, vehicleId, departureDate] thay vì chỉ [tourId, date],
// nên atomic decrement/cancel phải khớp cả 2 khoá. Snapshot routeOrigin/routeDestination/vehicleName
// tại thời điểm đặt — không join ngược lấy hiển thị cho booking đã tạo (backend/CLAUDE.md mục 3).
model TransportBooking {
  id               BigInt        @id @default(autoincrement())
  userId           BigInt        @map("user_id")
  routeId          BigInt        @map("route_id")
  vehicleId        BigInt        @map("vehicle_id")
  driverId         BigInt?       @map("driver_id")
  routeOrigin      String        @map("route_origin")
  routeDestination String        @map("route_destination")
  vehicleName      String        @map("vehicle_name")
  departureDate    DateTime      @map("departure_date") @db.Date
  numberOfPeople   Int           @map("number_of_people")
  customerName     String        @map("customer_name")
  customerEmail    String?       @map("customer_email")
  customerPhone    String?       @map("customer_phone")
  totalPrice       Decimal       @map("total_price") @db.Decimal(10, 2)
  currency         String        @default("VND")
  status           BookingStatus @default(PENDING_PAYMENT)
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")

  user    User           @relation(fields: [userId], references: [id])
  route   TransportRoute @relation(fields: [routeId], references: [id])
  vehicle Vehicle        @relation(fields: [vehicleId], references: [id])
  driver  Driver?        @relation(fields: [driverId], references: [id])

  @@index([userId])
  @@index([routeId])
  @@index([vehicleId])
  @@index([driverId])
  @@map("transport_bookings")
}

enum DriverStatus {
  ACTIVE
  INACTIVE
}

// Hạng mục cuối Backend V4 — workflow_and_database.md chỉ liệt kê tên bảng drivers/driver_assignments,
// không có field schema (cùng tình trạng dưới-đặc-tả các bảng khác của V4). Khác TourGuide (V3): Driver
// KHÔNG gắn với 1 User đã đăng ký sẵn — checklist V4 chỉ ghi "quản lý danh sách + gán Driver cho
// Booking", không có yêu cầu Driver tự đăng nhập/dashboard riêng như "Thêm Role Tour Guide" ở V3 — nên
// đơn giản hơn: Driver là 1 roster thuần do Transport Operator tự quản lý (mirror Vehicle: CRUD thuần,
// không cần Admin duyệt vì không hiển thị công khai cho khách). "driver_assignments" được hiện thực
// bằng 1 cột driverId trực tiếp trên TransportBooking (mirror TourSchedule.guideId) thay vì bảng join
// riêng — 1 Booking tại 1 thời điểm chỉ cần đúng 1 Driver, không cần metadata phụ để phải tách bảng.
model Driver {
  id            BigInt       @id @default(autoincrement())
  providerId    BigInt       @map("provider_id")
  name          String
  phone         String?
  licenseNumber String?      @map("license_number")
  status        DriverStatus @default(ACTIVE)
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")
  deletedAt     DateTime?    @map("deleted_at")

  provider Provider           @relation(fields: [providerId], references: [id])
  bookings TransportBooking[]

  @@index([providerId])
  @@map("drivers")
}

// ==================== V5 — Flight Booking ====================
// ProviderType.FLIGHT đã có san tu khi thiet ke schema V2 nhung chua dung toi, y het tinh huong
// TOUR/ACTIVITY/TRANSPORT truoc phase tuong ung cua chung. Airline Provider tiep tuc tai dung
// entity Provider (type=FLIGHT) — khong tao entity "Airline" rieng, dung luong apply/duyet/khoa
// da co. workflow_and_database.md muc 14 liet ke du 9 bang (airlines, aircrafts, airports,
// flight_routes, flights, flight_schedules, flight_seats, passengers, flight_bookings) nhung chi
// viet chi tiet field cho flights/flight_schedules/flight_seats — cung tinh trang duoi-dac-ta da
// gap o tour_guides (V3)/drivers (V4). "airlines" khong can bang rieng (= Provider type=FLIGHT).

// Airport la du lieu tham chieu dung chung, KHONG thuoc so huu cua Provider nao — mirror Destination
// (Admin quan ly, cong khai chi doc) chu khong mirror Vehicle/Aircraft (Provider tu quan ly). Khac
// Destination: dung id thay vi slug cho public detail (Airport la du lieu tra cuu/dropdown, khong
// co trang noi dung cong khai rieng nen khong can URL dep).
model Airport {
  id        BigInt    @id @default(autoincrement())
  code      String    @unique
  name      String
  city      String
  country   String
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  departureFlights Flight[] @relation("DepartureAirport")
  arrivalFlights   Flight[] @relation("ArrivalAirport")

  @@index([city])
  @@index([country])
  @@map("airports")
}

enum AircraftStatus {
  PENDING
  APPROVED
  REJECTED
}

// Aircraft thuoc so huu Airline Provider — mirror Vehicle het suc (CRUD + Admin duyet, khong
// hien cong khai rieng le, chi la tai nguyen de gan vao Flight Schedule sau nay).
// registrationCode (so hieu tau bay, VD "VN-A123") duy nhat toan he thong, cung ly do voi
// Vehicle.licensePlate — dung nghia thuc te 1 tau bay chi co dung 1 so hieu.
model Aircraft {
  id               BigInt         @id @default(autoincrement())
  providerId       BigInt         @map("provider_id")
  model            String
  registrationCode String         @unique @map("registration_code")
  economyCapacity  Int            @map("economy_capacity")
  businessCapacity Int            @default(0) @map("business_capacity")
  status           AircraftStatus @default(PENDING)
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")
  deletedAt        DateTime?      @map("deleted_at")

  provider Provider @relation(fields: [providerId], references: [id])
  flights  Flight[]

  @@index([providerId])
  @@map("aircrafts")
}

enum FlightStatus {
  PENDING
  APPROVED
  REJECTED
}

// Flight la entity cap cao nhat cua Airline Provider — mirror TransportRoute (can Admin duyet truoc
// khi cong khai, tim kiem cong khai theo cap San bay di/den dung luong "Search SGN -> HAN"). Khac
// TransportRoute: co san aircraftId truc tiep tren Flight (workflow_and_database.md muc 14 da cho
// field nay ro rang) — khac Transport khong co vehicleId co dinh vi 1 Route co the doi Vehicle theo
// tung ngay, o day 1 so hieu chuyen bay luon dung 1 loai Aircraft co dinh.
model Flight {
  id                 BigInt       @id @default(autoincrement())
  providerId         BigInt       @map("provider_id")
  aircraftId         BigInt       @map("aircraft_id")
  flightNumber       String       @map("flight_number")
  departureAirportId BigInt       @map("departure_airport_id")
  arrivalAirportId   BigInt       @map("arrival_airport_id")
  duration           Int
  status             FlightStatus @default(PENDING)
  createdAt          DateTime     @default(now()) @map("created_at")
  updatedAt          DateTime     @updatedAt @map("updated_at")
  deletedAt          DateTime?    @map("deleted_at")

  provider         Provider         @relation(fields: [providerId], references: [id])
  aircraft         Aircraft         @relation(fields: [aircraftId], references: [id])
  departureAirport Airport          @relation("DepartureAirport", fields: [departureAirportId], references: [id])
  arrivalAirport   Airport          @relation("ArrivalAirport", fields: [arrivalAirportId], references: [id])
  schedules        FlightSchedule[]

  @@index([providerId])
  @@index([aircraftId])
  @@index([departureAirportId])
  @@index([arrivalAirportId])
  @@map("flights")
}

enum FlightScheduleStatus {
  SCHEDULED
  CANCELLED
}

// Mirror TourSchedule (bulk-set theo khoang ngay, toi da 90 ngay) nhung KHONG co cot
// capacity/available/booked — workflow_and_database.md muc 14 khong liet ke cac cot do cho
// flight_schedules, vi ton kho ghe duoc quan ly hoan toan qua bang flight_seats rieng (hang muc
// Backend V5 tiep theo) thay vi 1 bo dem tong nhu Tour/Transport. departureTime/arrivalTime luu
// dang chuoi "HH:mm" tach rieng khoi departureDate, dung nhu 3 field rieng biet ma tai lieu goc da
// cho (date/departureTime/arrivalTime), tranh gop thanh 1 DateTime roi phai xu ly timezone khong
// can thiet cho mock data.
model FlightSchedule {
  id            BigInt               @id @default(autoincrement())
  flightId      BigInt               @map("flight_id")
  departureDate DateTime             @map("departure_date") @db.Date
  departureTime String               @map("departure_time")
  arrivalTime   String               @map("arrival_time")
  economyPrice  Decimal              @map("economy_price") @db.Decimal(10, 2)
  businessPrice Decimal?             @map("business_price") @db.Decimal(10, 2)
  status        FlightScheduleStatus @default(SCHEDULED)
  createdAt     DateTime             @default(now()) @map("created_at")
  updatedAt     DateTime             @updatedAt @map("updated_at")

  flight   Flight          @relation(fields: [flightId], references: [id])
  seats    FlightSeat[]
  bookings FlightBooking[]

  @@unique([flightId, departureDate])
  @@index([flightId])
  @@map("flight_schedules")
}

enum SeatClass {
  ECONOMY
  BUSINESS
}

enum FlightSeatStatus {
  AVAILABLE
  BOOKED
}

// Hang muc Backend V5 thu 3 — day la noi khac hoan toan co che "tru ton kho theo so luong" da dung
// nhat quan tu Room/Tour/Experience/Transport: moi ghe la 1 dong rieng (dung workflow_and_database.md
// muc 14 da cho cho flight_seats), khach chon dung 1 ghe cu the thay vi chi nhap so luong. Tu dong
// sinh du seatNumber/class khi 1 FlightSchedule MOI duoc tao (khong sinh lai khi set lai lich cu, vi
// ghe cu co the da BOOKED) — dung theo economyCapacity/businessCapacity co san tren Aircraft cua
// chinh Flight do (2 cot nay da duoc chuan bi san tu luc xay Aircraft). scheduleId+seatNumber duy
// nhat — khong the co 2 ghe cung so hieu trong cung 1 chuyen bay cu the.
model FlightSeat {
  id         BigInt           @id @default(autoincrement())
  scheduleId BigInt           @map("schedule_id")
  seatNumber String           @map("seat_number")
  class      SeatClass
  status     FlightSeatStatus @default(AVAILABLE)
  createdAt  DateTime         @default(now()) @map("created_at")
  updatedAt  DateTime         @updatedAt @map("updated_at")

  schedule   FlightSchedule @relation(fields: [scheduleId], references: [id])
  passengers Passenger[]

  @@unique([scheduleId, seatNumber])
  @@index([scheduleId])
  @@map("flight_seats")
}

// Hang muc cuoi cung Backend V5 — workflow_and_database.md muc 14 chi cho ten bang flight_bookings/
// passengers, khong co field schema (cung tinh trang duoi-dac-ta cac bang khac cua V5). Mirror
// TransportBooking (snapshot flightNumber/gio/gia tai thoi diem dat, KHONG bao gio join nguoc lay
// gia hien thi — dung backend/CLAUDE.md muc 3), nhung khac moi Booking truoc do: chong overbooking
// bang cach flip tung dong FlightSeat rieng (status AVAILABLE -> BOOKED qua raw UPDATE ... WHERE
// status = 'AVAILABLE' AND id IN (...), kiem tra affected rows = so ghe yeu cau) thay vi tru 1 bo dem
// tong nhu Room/Tour/Experience/Transport — dung ca co che nay cho ca 2 chieu tao/huy booking.
model FlightBooking {
  id                   BigInt        @id @default(autoincrement())
  userId               BigInt        @map("user_id")
  scheduleId           BigInt        @map("schedule_id")
  flightNumber         String        @map("flight_number")
  departureAirportCode String        @map("departure_airport_code")
  arrivalAirportCode   String        @map("arrival_airport_code")
  departureDate        DateTime      @map("departure_date") @db.Date
  departureTime        String        @map("departure_time")
  arrivalTime          String        @map("arrival_time")
  numberOfPassengers   Int           @map("number_of_passengers")
  customerName         String        @map("customer_name")
  customerEmail        String?       @map("customer_email")
  customerPhone        String?       @map("customer_phone")
  totalPrice           Decimal       @map("total_price") @db.Decimal(10, 2)
  currency             String        @default("VND")
  status               BookingStatus @default(PENDING_PAYMENT)
  createdAt            DateTime      @default(now()) @map("created_at")
  updatedAt            DateTime      @updatedAt @map("updated_at")

  user       User           @relation(fields: [userId], references: [id])
  schedule   FlightSchedule @relation(fields: [scheduleId], references: [id])
  passengers Passenger[]

  @@index([userId])
  @@index([scheduleId])
  @@map("flight_bookings")
}

// 1 dong / 1 hanh khach / 1 ghe cu the trong 1 FlightBooking — seatId khong unique toan cuc vi 1 ghe
// (FlightSeat) co the duoc dat lai boi hanh khach khac sau khi booking cu bi huy (seat tra ve
// AVAILABLE), nen lich su co the co nhieu dong Passenger cung tro ve 1 seatId qua nhieu lan dat khac
// nhau. idNumber la CCCD/ho chieu — mock data, khong xac thuc that.
model Passenger {
  id              BigInt   @id @default(autoincrement())
  flightBookingId BigInt   @map("flight_booking_id")
  seatId          BigInt   @map("seat_id")
  fullName        String   @map("full_name")
  idNumber        String   @map("id_number")
  createdAt       DateTime @default(now()) @map("created_at")

  booking FlightBooking @relation(fields: [flightBookingId], references: [id])
  seat    FlightSeat    @relation(fields: [seatId], references: [id])

  @@index([flightBookingId])
  @@index([seatId])
  @@map("passengers")
}

// V6 — Payment. workflow_and_database.md mo ta payments.bookingId nhu 1 FK don (tu duy 1 bang
// "bookings" chung kieu MongoDB), nhung schema MySQL that cua Tripora co 5 bang Booking tach biet
// (hotel_bookings/tour_bookings/experience_bookings/transport_bookings/flight_bookings), khong co
// bang "bookings" gop — Prisma khong ho tro FK tro toi nhieu bang khac nhau. Dung cap cot
// bookingDomain + bookingId (khong phai FK Prisma that, chi luu id tho) — tra cuu Booking that su
// lam o tang Service bang cach dispatch theo bookingDomain sang dung Repository tuong ung.
enum BookingDomain {
  HOTEL
  TOUR
  EXPERIENCE
  TRANSPORT
  FLIGHT
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
}

// transactionId luu Stripe Checkout Session id (hoac PaymentIntent id) khi da biet, chi de tham
// khao/audit — webhook tra ve dung Payment can cap nhat qua metadata.paymentId gan san luc tao
// Checkout Session, khong can tra nguoc qua transactionId.
model Payment {
  id              BigInt        @id @default(autoincrement())
  userId          BigInt        @map("user_id")
  bookingDomain   BookingDomain @map("booking_domain")
  bookingId       BigInt        @map("booking_id")
  amount          Decimal       @map("amount") @db.Decimal(10, 2)
  discountAmount  Decimal       @default(0) @map("discount_amount") @db.Decimal(10, 2)
  currency        String        @default("VND")
  provider        String        @default("stripe")
  method          String?
  status          PaymentStatus @default(PENDING)
  transactionId   String?       @map("transaction_id")
  paymentIntentId String?       @map("payment_intent_id")
  paidAt          DateTime?     @map("paid_at")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  user    User     @relation(fields: [userId], references: [id])
  invoice Invoice?
  refund  Refund?

  @@index([userId])
  @@index([bookingDomain, bookingId])
  @@map("payments")
}

enum InvoiceStatus {
  ISSUED
}

// subtotal = amount + discountAmount (gia niem yet truoc giam gia), discount = discountAmount,
// total = amount (so tien thuc charge qua Stripe) — dung khi Payment.discountAmount > 0 tu Coupon/Promotion.
model Invoice {
  id            BigInt        @id @default(autoincrement())
  userId        BigInt        @map("user_id")
  paymentId     BigInt        @unique @map("payment_id")
  bookingDomain BookingDomain @map("booking_domain")
  bookingId     BigInt        @map("booking_id")
  invoiceNumber String        @unique @map("invoice_number")
  subtotal      Decimal       @db.Decimal(10, 2)
  discount      Decimal       @default(0) @db.Decimal(10, 2)
  tax           Decimal       @default(0) @db.Decimal(10, 2)
  total         Decimal       @db.Decimal(10, 2)
  currency      String        @default("VND")
  status        InvoiceStatus @default(ISSUED)
  createdAt     DateTime      @default(now()) @map("created_at")

  user    User    @relation(fields: [userId], references: [id])
  payment Payment @relation(fields: [paymentId], references: [id])

  @@index([userId])
  @@map("invoices")
}

enum DiscountType {
  PERCENT
  FIXED
}

enum PromoStatus {
  ACTIVE
  INACTIVE
}

// applicableDomains: null = ap dung moi domain, khong thi Json array cac gia tri BookingDomain
// (VD ["TOUR","EXPERIENCE"]) — khong dung Prisma array/relation vi khong can filter/join rieng
// (database.md muc 7). discountValue: PERCENT la % (0-100), FIXED la so tien VND truc tiep.
model Coupon {
  id                BigInt       @id @default(autoincrement())
  code              String       @unique
  discountType      DiscountType @map("discount_type")
  discountValue     Decimal      @map("discount_value") @db.Decimal(10, 2)
  maxDiscountAmount Decimal?     @map("max_discount_amount") @db.Decimal(10, 2)
  minOrderAmount    Decimal      @default(0) @map("min_order_amount") @db.Decimal(10, 2)
  applicableDomains Json?        @map("applicable_domains")
  usageLimit        Int?         @map("usage_limit")
  usedCount         Int          @default(0) @map("used_count")
  perUserLimit      Int?         @map("per_user_limit")
  validFrom         DateTime     @map("valid_from")
  validUntil        DateTime     @map("valid_until")
  status            PromoStatus  @default(ACTIVE)
  createdAt         DateTime     @default(now()) @map("created_at")
  updatedAt         DateTime     @updatedAt @map("updated_at")

  redemptions CouponRedemption[]

  @@map("coupons")
}

// 1 redemption / 1 Booking (unique bookingDomain+bookingId) — dung de hoan lai usedCount khi
// Booking PENDING_PAYMENT dung coupon do het han (BookingExpirationService), va de audit lich su.
model CouponRedemption {
  id             BigInt        @id @default(autoincrement())
  couponId       BigInt        @map("coupon_id")
  userId         BigInt        @map("user_id")
  bookingDomain  BookingDomain @map("booking_domain")
  bookingId      BigInt        @map("booking_id")
  discountAmount Decimal       @map("discount_amount") @db.Decimal(10, 2)
  createdAt      DateTime      @default(now()) @map("created_at")

  coupon Coupon @relation(fields: [couponId], references: [id])
  user   User   @relation(fields: [userId], references: [id])

  @@unique([bookingDomain, bookingId])
  @@index([couponId])
  @@index([userId])
  @@map("coupon_redemptions")
}

// Giam gia tu dong, khong can ma — ap dung khi tao Booking neu khach khong nhap couponCode.
// Khong theo doi usageLimit/redemption (khac Coupon) vi la campaign toan san, khong gioi han theo
// nguoi dung. priority cao hon duoc chon truoc khi nhieu Promotion cung khop 1 luc.
// V7 vong 11: providerId null = Admin tao, ap dung toan san trong applicableDomains; providerId co
// gia tri = Provider tu tao cho dung 1 domain cua minh (Service tu gan applicableDomains, khong
// nhan tu client) — findBestActivePromotion khop ca 2 loai, uu tien theo priority.
model Promotion {
  id                BigInt       @id @default(autoincrement())
  providerId        BigInt?      @map("provider_id")
  name              String
  discountType      DiscountType @map("discount_type")
  discountValue     Decimal      @map("discount_value") @db.Decimal(10, 2)
  maxDiscountAmount Decimal?     @map("max_discount_amount") @db.Decimal(10, 2)
  minOrderAmount    Decimal      @default(0) @map("min_order_amount") @db.Decimal(10, 2)
  applicableDomains Json?        @map("applicable_domains")
  priority          Int          @default(0)
  validFrom         DateTime     @map("valid_from")
  validUntil        DateTime     @map("valid_until")
  status            PromoStatus  @default(ACTIVE)
  createdAt         DateTime     @default(now()) @map("created_at")
  updatedAt         DateTime     @updatedAt @map("updated_at")

  provider Provider? @relation(fields: [providerId], references: [id])

  @@index([providerId])
  @@map("promotions")
}

enum RefundStatus {
  PENDING
  SUCCESS
  FAILED
}

// 1 Refund / 1 Payment (paymentId unique) — huy Booking CONFIRMED chi tao duoc toi da 1 lan (status
// guard cua cancelBooking chi cho phep tu CONFIRMED). percent/amount tinh theo REFUND_FULL_DAYS/
// REFUND_PARTIAL_DAYS luc huy — amount=0 (ngoai moc hoan tien) van tao 1 dong SUCCESS de luu lich
// su, khong goi Stripe, Booking dung lai o CANCELLED (khong sang REFUND_PENDING). amount>0: PENDING
// cho toi khi webhook refund.updated (status succeeded) xac nhan that -> SUCCESS (backend/CLAUDE.md
// muc 3 "Payment Verify" ap dung them cho Refund, khong rieng Payment).
model Refund {
  id             BigInt        @id @default(autoincrement())
  paymentId      BigInt        @unique @map("payment_id")
  userId         BigInt        @map("user_id")
  bookingDomain  BookingDomain @map("booking_domain")
  bookingId      BigInt        @map("booking_id")
  amount         Decimal       @db.Decimal(10, 2)
  percent        Int
  reason         String?       @db.Text
  status         RefundStatus  @default(PENDING)
  stripeRefundId String?       @map("stripe_refund_id")
  processedAt    DateTime?     @map("processed_at")
  createdAt      DateTime      @default(now()) @map("created_at")

  user    User    @relation(fields: [userId], references: [id])
  payment Payment @relation(fields: [paymentId], references: [id])

  @@index([userId])
  @@index([bookingDomain, bookingId])
  @@map("refunds")
}

// Ban ghi audit hoa hong Platform — sinh 1 lan khi Payment SUCCESS (khong tu dieu chinh/hoan lai
// khi Booking sau do bi Refund, xem CHANGELOG). rate la snapshot Provider.commissionRate tai thoi
// diem tinh (khong join nguoc de biet rate da thay doi hay chua). grossAmount = Payment.amount
// (da tru discount, thuc thu qua Stripe).
enum PayoutStatus {
  PENDING
  PAID
}

model Commission {
  id             BigInt        @id @default(autoincrement())
  providerId     BigInt        @map("provider_id")
  paymentId      BigInt        @unique @map("payment_id")
  bookingDomain  BookingDomain @map("booking_domain")
  bookingId      BigInt        @map("booking_id")
  grossAmount    Decimal       @map("gross_amount") @db.Decimal(10, 2)
  rate           Decimal       @db.Decimal(5, 4)
  platformAmount Decimal       @map("platform_amount") @db.Decimal(10, 2)
  providerAmount Decimal       @map("provider_amount") @db.Decimal(10, 2)
  // V7 vong 4 — Payout toi gian: 1 dong = 1 trang thai, Admin tu tay danh dau da tra (chuyen khoan
  // ngoai he thong), khong batch/khong tich hop API chuyen tien that.
  payoutStatus   PayoutStatus  @default(PENDING) @map("payout_status")
  paidAt         DateTime?     @map("paid_at")
  createdAt      DateTime      @default(now()) @map("created_at")

  provider Provider @relation(fields: [providerId], references: [id])

  @@index([providerId])
  @@map("commissions")
}

// V8 vong 1 — Post (Travel Story): noi dung du lich nguoi dung tu dang, gan Destination tuy chon,
// bat buoc it nhat 1 anh. Gop 2 ten bang "posts"/"travel_stories" trong workflow_and_database.md
// muc 24 thanh 1 model duy nhat (YAGNI — chua co ly do tach story nhieu-ngay/nhieu-item rieng voi
// post don, tranh over-engineer som). Kiem duyet an bang deletedAt (khong xoa cung) qua chung 1
// endpoint remove() voi chinh chu, mirror Review.remove() (userId=chu bai hoac role=ADMIN).
model Post {
  id            BigInt    @id @default(autoincrement())
  userId        BigInt    @map("user_id")
  destinationId BigInt?   @map("destination_id")
  caption       String    @db.Text
  images        Json
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  deletedAt     DateTime? @map("deleted_at")

  user        User         @relation(fields: [userId], references: [id])
  destination Destination? @relation(fields: [destinationId], references: [id])
  likes       Like[]
  savedBy     SavedPost[]
  comments    Comment[]

  @@index([userId])
  @@index([destinationId])
  @@map("posts")
}

// V8 vong 2 — Like/Save deu la toggle idempotent theo cap (userId, postId), mirror chinh xac
// WishlistItem (unique composite + findUnique de add khong tao trung, deleteMany de remove
// khong loi neu goi 2 lan). Tach 2 model rieng (khong gop chung 1 bang "reaction") vi 2 y nghia
// khac nhau: Like la tin hieu cong khai (hien so luot thich), Save la bookmark ca nhan (chi chu
// so huu thay), giong tinh than Wishlist da co tu V1.
model Like {
  id        BigInt   @id @default(autoincrement())
  userId    BigInt   @map("user_id")
  postId    BigInt   @map("post_id")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])
  post Post @relation(fields: [postId], references: [id])

  @@unique([userId, postId])
  @@index([postId])
  @@map("likes")
}

model SavedPost {
  id        BigInt   @id @default(autoincrement())
  userId    BigInt   @map("user_id")
  postId    BigInt   @map("post_id")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])
  post Post @relation(fields: [postId], references: [id])

  @@unique([userId, postId])
  @@index([postId])
  @@map("saved_posts")
}

// V8 vong 3 — Follow (user-to-user), cung khuon toggle idempotent nhu Like/SavedPost nhung tham
// chieu 2 lan len User (tu quan he) nen can 2 relation name rieng. followerId = nguoi bam theo doi,
// followingId = nguoi duoc theo doi. Chan tu theo doi chinh minh o Service (khong phai DB constraint).
model Follow {
  id          BigInt   @id @default(autoincrement())
  followerId  BigInt   @map("follower_id")
  followingId BigInt   @map("following_id")
  createdAt   DateTime @default(now()) @map("created_at")

  follower  User @relation("Follower", fields: [followerId], references: [id])
  following User @relation("Following", fields: [followingId], references: [id])

  @@unique([followerId, followingId])
  @@index([followingId])
  @@map("follows")
}

// V8 vong 4 — Comment la muc cuoi cung cua checklist "Like/Follow/Comment/Save", khac 3 muc kia vi
// khong phai toggle idempotent ma la CRUD that (co content, sua/xoa duoc) — mirror Review (soft
// delete dung chung cho chu comment tu xoa HOAC Admin kiem duyet, khong xoa cung).
model Comment {
  id        BigInt    @id @default(autoincrement())
  userId    BigInt    @map("user_id")
  postId    BigInt    @map("post_id")
  content   String    @db.Text
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  user User @relation(fields: [userId], references: [id])
  post Post @relation(fields: [postId], references: [id])

  @@index([postId])
  @@map("comments")
}
