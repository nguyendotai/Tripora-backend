// Tripora - Prisma Schema (MySQL)
// Quy tắc naming: xem .claude/database.md — model PascalCase/field camelCase (Prisma),
// map sang table/column snake_case qua @map/@@map. PK: BigInt UNSIGNED AUTO_INCREMENT.
// MVP scope: xem PROJECT_STATUS.md / Database_and_workflows.md mục 34.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ============ ENUMS ============

enum UserRole {
  TRAVELER
  PARTNER
  ADMIN
  SUPER_ADMIN
}

enum UserStatus {
  ACTIVE
  INACTIVE
  BANNED
}

enum PartnerBusinessType {
  HOTEL
  TOUR
  RESTAURANT
  VEHICLE
}

enum PartnerVerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum PartnerStatus {
  ACTIVE
  SUSPENDED
}

enum PropertyType {
  HOTEL
  RESORT
  VILLA
  APARTMENT
  HOSTEL
  HOMESTAY
}

enum PropertyStatus {
  ACTIVE
  INACTIVE
  PENDING_APPROVAL
}

enum RoomStatus {
  ACTIVE
  INACTIVE
}

enum AvailabilityStatus {
  AVAILABLE
  SOLD_OUT
  CLOSED
}

enum ProductType {
  TOUR
  ACTIVITY
  ATTRACTION
  EXPERIENCE
}

enum ProductStatus {
  ACTIVE
  INACTIVE
  PENDING_APPROVAL
}

enum BookingType {
  HOTEL
  TOUR
  ACTIVITY
  RESTAURANT
  VEHICLE
}

enum BookingStatus {
  PENDING
  PAYMENT_PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  UNPAID
  PAID
  REFUNDED
}

enum TxPaymentStatus {
  PENDING
  SUCCESS
  FAILED
}

enum RefundStatus {
  PROCESSING
  COMPLETED
  FAILED
}

enum ReviewTargetType {
  PROPERTY
  PRODUCT
  RESTAURANT
}

enum ReviewStatus {
  PUBLISHED
  PENDING
  REJECTED
}

enum CouponType {
  PERCENTAGE
  FIXED
}

enum CouponStatus {
  ACTIVE
  EXPIRED
  DISABLED
}

// ============ IDENTITY (auth.md / user.md) ============

model User {
  id             BigInt     @id @default(autoincrement()) @db.UnsignedBigInt
  email          String     @unique @db.VarChar(255)
  passwordHash   String?    @map("password_hash") @db.VarChar(255)
  googleId       String?    @map("google_id") @db.VarChar(255)
  role           UserRole   @default(TRAVELER)
  status         UserStatus @default(ACTIVE)

  firstName      String?    @map("first_name") @db.VarChar(100)
  lastName       String?    @map("last_name") @db.VarChar(100)
  avatarUrl      String?    @map("avatar_url") @db.VarChar(255)
  avatarPublicId String?    @map("avatar_public_id") @db.VarChar(255)
  phone          String?    @db.VarChar(20)
  dateOfBirth    DateTime?  @map("date_of_birth") @db.Date

  currency       String     @default("VND") @db.VarChar(10)
  language       String     @default("vi") @db.VarChar(10)
  travelStyles   Json?      @map("travel_styles")

  createdAt      DateTime   @default(now()) @map("created_at")
  updatedAt      DateTime   @updatedAt @map("updated_at")
  deletedAt      DateTime?  @map("deleted_at")

  refreshTokens  RefreshToken[]
  partner        Partner?
  bookings       Booking[]
  reviews        Review[]
  notifications  Notification[]
  payments       Payment[]
  activityLogs   ActivityLog[]

  @@map("users")
}

model RefreshToken {
  id        BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  userId    BigInt    @map("user_id") @db.UnsignedBigInt
  tokenHash String    @map("token_hash") @db.VarChar(255)
  revokedAt DateTime? @map("revoked_at")
  expiresAt DateTime  @map("expires_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("refresh_tokens")
}

// ============ MARKETPLACE (partner.md) ============

model Partner {
  id                 BigInt                    @id @default(autoincrement()) @db.UnsignedBigInt
  ownerId            BigInt                    @unique @map("owner_id") @db.UnsignedBigInt
  businessName       String                    @map("business_name") @db.VarChar(255)
  businessType       PartnerBusinessType       @map("business_type")
  contactEmail       String?                   @map("contact_email") @db.VarChar(255)
  contactPhone       String?                   @map("contact_phone") @db.VarChar(20)
  verificationStatus PartnerVerificationStatus @default(PENDING) @map("verification_status")
  verifiedAt         DateTime?                 @map("verified_at")
  ratingAverage      Decimal                   @default(0) @map("rating_average") @db.Decimal(3, 2)
  ratingCount        Int                       @default(0) @map("rating_count") @db.UnsignedInt
  status             PartnerStatus             @default(ACTIVE)
  createdAt          DateTime                  @default(now()) @map("created_at")
  updatedAt          DateTime                  @updatedAt @map("updated_at")
  deletedAt          DateTime?                 @map("deleted_at")

  owner      User       @relation(fields: [ownerId], references: [id])
  properties Property[]
  products   Product[]
  bookings   Booking[]

  @@map("partners")
}

// ============ DISCOVERY (destination.md / property.md / room.md / room-availability.md / product.md / product-schedule.md) ============

model Destination {
  id          BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  name        String    @db.VarChar(255)
  slug        String    @unique @db.VarChar(255)
  country     String?   @db.VarChar(100)
  latitude    Decimal?  @db.Decimal(10, 7)
  longitude   Decimal?  @db.Decimal(10, 7)
  description String?   @db.Text
  images      Json?
  tags        Json?
  bestTime    Json?     @map("best_time")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  properties Property[]
  products   Product[]

  @@map("destinations")
}

model Property {
  id                  BigInt         @id @default(autoincrement()) @db.UnsignedBigInt
  partnerId           BigInt         @map("partner_id") @db.UnsignedBigInt
  destinationId       BigInt         @map("destination_id") @db.UnsignedBigInt
  type                PropertyType
  name                String         @db.VarChar(255)
  slug                String         @unique @db.VarChar(255)
  description         String?        @db.Text
  address             String?        @db.VarChar(255)
  city                String?        @db.VarChar(100)
  country             String?        @db.VarChar(100)
  latitude            Decimal?       @db.Decimal(10, 7)
  longitude           Decimal?       @db.Decimal(10, 7)
  images              Json?
  amenities           Json?
  ratingAverage       Decimal        @default(0) @map("rating_average") @db.Decimal(3, 2)
  ratingCount         Int            @default(0) @map("rating_count") @db.UnsignedInt
  checkInTime         String?        @map("check_in_time") @db.VarChar(5)
  checkOutTime        String?        @map("check_out_time") @db.VarChar(5)
  cancellationPolicy  String?        @map("cancellation_policy") @db.Text
  status              PropertyStatus @default(PENDING_APPROVAL)
  createdAt           DateTime       @default(now()) @map("created_at")
  updatedAt           DateTime       @updatedAt @map("updated_at")
  deletedAt           DateTime?      @map("deleted_at")

  partner     Partner     @relation(fields: [partnerId], references: [id])
  destination Destination @relation(fields: [destinationId], references: [id])
  rooms       Room[]

  @@index([partnerId])
  @@index([destinationId])
  @@map("properties")
}

model Room {
  id                BigInt     @id @default(autoincrement()) @db.UnsignedBigInt
  propertyId        BigInt     @map("property_id") @db.UnsignedBigInt
  name              String     @db.VarChar(255)
  type              String?    @db.VarChar(50)
  capacityAdults    Int        @default(1) @map("capacity_adults") @db.UnsignedInt
  capacityChildren  Int        @default(0) @map("capacity_children") @db.UnsignedInt
  bedType           String?    @map("bed_type") @db.VarChar(50)
  amenities         Json?
  images            Json?
  basePrice         Decimal    @map("base_price") @db.Decimal(12, 2)
  currency          String     @default("VND") @db.VarChar(10)
  status            RoomStatus @default(ACTIVE)
  createdAt         DateTime   @default(now()) @map("created_at")
  updatedAt         DateTime   @updatedAt @map("updated_at")
  deletedAt         DateTime?  @map("deleted_at")

  property      Property           @relation(fields: [propertyId], references: [id])
  availabilities RoomAvailability[]

  @@index([propertyId])
  @@map("rooms")
}

model RoomAvailability {
  id        BigInt              @id @default(autoincrement()) @db.UnsignedBigInt
  roomId    BigInt              @map("room_id") @db.UnsignedBigInt
  date      DateTime            @db.Date
  total     Int                 @db.UnsignedInt
  available Int                 @db.UnsignedInt
  price     Decimal             @db.Decimal(12, 2)
  status    AvailabilityStatus  @default(AVAILABLE)

  room Room @relation(fields: [roomId], references: [id])

  @@unique([roomId, date])
  @@map("room_availabilities")
}

model Product {
  id                BigInt        @id @default(autoincrement()) @db.UnsignedBigInt
  partnerId         BigInt        @map("partner_id") @db.UnsignedBigInt
  destinationId     BigInt        @map("destination_id") @db.UnsignedBigInt
  type              ProductType
  name              String        @db.VarChar(255)
  description       String?       @db.Text
  duration          Int?          @db.UnsignedInt
  capacity          Int?          @db.UnsignedInt
  basePrice         Decimal       @map("base_price") @db.Decimal(12, 2)
  currency          String        @default("VND") @db.VarChar(10)
  images            Json?
  meetingPointName  String?       @map("meeting_point_name") @db.VarChar(255)
  meetingPointLat   Decimal?      @map("meeting_point_lat") @db.Decimal(10, 7)
  meetingPointLng   Decimal?      @map("meeting_point_lng") @db.Decimal(10, 7)
  status            ProductStatus @default(PENDING_APPROVAL)
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")
  deletedAt         DateTime?     @map("deleted_at")

  partner     Partner           @relation(fields: [partnerId], references: [id])
  destination Destination       @relation(fields: [destinationId], references: [id])
  schedules   ProductSchedule[]

  @@index([partnerId])
  @@index([destinationId])
  @@map("products")
}

model ProductSchedule {
  id        BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  productId BigInt   @map("product_id") @db.UnsignedBigInt
  date      DateTime @db.Date
  startTime String   @map("start_time") @db.VarChar(5)
  capacity  Int      @db.UnsignedInt
  available Int      @db.UnsignedInt

  product Product @relation(fields: [productId], references: [id])

  @@index([productId])
  @@map("product_schedules")
}

// ============ BOOKING (booking.md / payment.md / refund.md) ============

model Booking {
  id            BigInt        @id @default(autoincrement()) @db.UnsignedBigInt
  bookingCode   String        @unique @map("booking_code") @db.VarChar(20)
  userId        BigInt        @map("user_id") @db.UnsignedBigInt
  partnerId     BigInt        @map("partner_id") @db.UnsignedBigInt
  type          BookingType
  status        BookingStatus @default(PENDING)

  guestName     String?       @map("guest_name") @db.VarChar(255)
  guestEmail    String?       @map("guest_email") @db.VarChar(255)
  guestPhone    String?       @map("guest_phone") @db.VarChar(20)

  subtotal      Decimal       @db.Decimal(12, 2)
  discount      Decimal       @default(0) @db.Decimal(12, 2)
  tax           Decimal       @default(0) @db.Decimal(12, 2)
  total         Decimal       @db.Decimal(12, 2)

  paymentStatus PaymentStatus @default(UNPAID) @map("payment_status")

  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")
  deletedAt     DateTime?     @map("deleted_at")

  user    User          @relation(fields: [userId], references: [id])
  partner Partner       @relation(fields: [partnerId], references: [id])
  items   BookingItem[]
  payments Payment[]
  refunds Refund[]
  review  Review?

  @@index([userId])
  @@index([partnerId])
  @@index([status])
  @@index([createdAt])
  @@map("bookings")
}

model BookingItem {
  id         BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  bookingId  BigInt   @map("booking_id") @db.UnsignedBigInt
  resourceId BigInt   @map("resource_id") @db.UnsignedBigInt
  name       String   @db.VarChar(255)
  quantity   Int      @default(1) @db.UnsignedInt
  date       DateTime? @db.Date
  price      Decimal  @db.Decimal(12, 2)
  currency   String   @default("VND") @db.VarChar(10)

  booking Booking @relation(fields: [bookingId], references: [id])

  @@index([bookingId])
  @@map("booking_items")
}

model Payment {
  id            BigInt          @id @default(autoincrement()) @db.UnsignedBigInt
  bookingId     BigInt          @map("booking_id") @db.UnsignedBigInt
  userId        BigInt          @map("user_id") @db.UnsignedBigInt
  provider      String?         @db.VarChar(50)
  transactionId String?         @map("transaction_id") @db.VarChar(100)
  amount        Decimal         @db.Decimal(12, 2)
  currency      String          @default("VND") @db.VarChar(10)
  status        TxPaymentStatus @default(PENDING)
  paidAt        DateTime?       @map("paid_at")
  createdAt     DateTime        @default(now()) @map("created_at")

  booking Booking  @relation(fields: [bookingId], references: [id])
  user    User     @relation(fields: [userId], references: [id])
  refunds Refund[]

  @@index([bookingId])
  @@map("payments")
}

model Refund {
  id        BigInt       @id @default(autoincrement()) @db.UnsignedBigInt
  bookingId BigInt       @map("booking_id") @db.UnsignedBigInt
  paymentId BigInt       @map("payment_id") @db.UnsignedBigInt
  amount    Decimal      @db.Decimal(12, 2)
  reason    String?      @db.VarChar(255)
  status    RefundStatus @default(PROCESSING)
  createdAt DateTime     @default(now()) @map("created_at")

  booking Booking @relation(fields: [bookingId], references: [id])
  payment Payment @relation(fields: [paymentId], references: [id])

  @@index([bookingId])
  @@map("refunds")
}

// ============ REVIEW / COUPON / NOTIFICATION ============

model Review {
  id         BigInt           @id @default(autoincrement()) @db.UnsignedBigInt
  userId     BigInt           @map("user_id") @db.UnsignedBigInt
  bookingId  BigInt           @unique @map("booking_id") @db.UnsignedBigInt
  targetType ReviewTargetType @map("target_type")
  targetId   BigInt           @map("target_id") @db.UnsignedBigInt
  rating     Int              @db.UnsignedTinyInt
  title      String?          @db.VarChar(255)
  content    String?          @db.Text
  images     Json?
  verified   Boolean          @default(true)
  status     ReviewStatus     @default(PENDING)
  createdAt  DateTime         @default(now()) @map("created_at")

  user       User            @relation(fields: [userId], references: [id])
  booking    Booking         @relation(fields: [bookingId], references: [id])

  // targetId là tham chiếu mềm (Property/Product/Restaurant tuỳ targetType) — không dùng FK thật
  // vì là quan hệ polymorphic, xem specs/review.md mục 2.
  @@index([targetId, targetType])
  @@map("reviews")
}

model Coupon {
  id             BigInt       @id @default(autoincrement()) @db.UnsignedBigInt
  code           String       @unique @db.VarChar(50)
  type           CouponType
  value          Decimal      @db.Decimal(12, 2)
  maxDiscount    Decimal?     @map("max_discount") @db.Decimal(12, 2)
  minimumAmount  Decimal?     @map("minimum_amount") @db.Decimal(12, 2)
  usageLimit     Int?         @map("usage_limit") @db.UnsignedInt
  usedCount      Int          @default(0) @map("used_count") @db.UnsignedInt
  startAt        DateTime?    @map("start_at")
  endAt          DateTime?    @map("end_at")
  status         CouponStatus @default(ACTIVE)
  createdAt      DateTime     @default(now()) @map("created_at")

  @@map("coupons")
}

model Notification {
  id        BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  userId    BigInt   @map("user_id") @db.UnsignedBigInt
  type      String   @db.VarChar(50)
  title     String?  @db.VarChar(255)
  message   String?  @db.Text
  data      Json?
  isRead    Boolean  @default(false) @map("is_read")
  createdAt DateTime @default(now()) @map("created_at")
  deletedAt DateTime? @map("deleted_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("notifications")
}

// ============ ACTIVITY LOG (specs/activity-log.md) — append-only audit, không có API sửa/xóa ============

model ActivityLog {
  id           BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  actorId      BigInt?  @map("actor_id") @db.UnsignedBigInt
  action       String   @db.VarChar(100)
  resourceType String   @map("resource_type") @db.VarChar(50)
  // resourceId là tham chiếu mềm (không FK cứng) vì resourceType đổi mục tiêu theo action
  resourceId   BigInt?  @map("resource_id") @db.UnsignedBigInt
  metadata     Json?
  createdAt    DateTime @default(now()) @map("created_at")

  actor User? @relation(fields: [actorId], references: [id])

  @@index([actorId])
  @@index([resourceType, resourceId])
  @@index([createdAt])
  @@map("activity_logs")
}
