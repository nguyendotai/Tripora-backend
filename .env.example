DATABASE_URL="mysql://root:password@localhost:3306/tripora"
JWT_ACCESS_SECRET=change-me
JWT_REFRESH_SECRET=change-me
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
PORT=5550

# Cloudinary Dashboard -> API Keys page. CLOUDINARY_CLOUD_NAME is the
# "Cloud name" shown at the top of that page, NOT the API key's Key Name.
CLOUDINARY_CLOUD_NAME=change-me
CLOUDINARY_API_KEY=change-me
CLOUDINARY_API_SECRET=change-me

# Stripe Dashboard (Test mode) -> Developers -> API keys page.
STRIPE_SECRET_KEY=change-me
# Stripe CLI: `stripe listen --forward-to http://localhost:5550/api/v1/payments/webhook`
# prints this value ("Signing secret", starts with whsec_).
STRIPE_WEBHOOK_SECRET=change-me
# Frontend routes Stripe redirects the customer back to after Checkout.
STRIPE_SUCCESS_URL=http://localhost:3003/checkout/success
STRIPE_CANCEL_URL=http://localhost:3003/checkout/cancel
# Minutes a PENDING_PAYMENT booking holds its inventory before the expiration job releases it.
BOOKING_PAYMENT_EXPIRY_MINUTES=30
