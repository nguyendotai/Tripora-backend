# App
NODE_ENV=development
PORT=5550
API_PREFIX=api/v1
CORS_ORIGIN=http://localhost:3002,http://localhost:3003

# Database (MySQL - xem .claude/database.md)
DATABASE_URL="mysql://root:@localhost:3306/tripora"

# JWT
JWT_ACCESS_SECRET=change-me-access-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_REFRESH_EXPIRES_IN=7d

# Redis (Cache + Reservation Lock + BullMQ)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TLS=false

# Cloudinary (Storage ảnh Property/Room/Product/Avatar)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# SMTP (Email)
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Tripora <no-reply@tripora.local>"

# Google OAuth (optional)
GOOGLE_CLIENT_ID=

# Payment Gateway Webhook — placeholder HMAC secret cho tới khi tích hợp Gateway thật (VNPAY/Momo/Stripe)
PAYMENT_WEBHOOK_SECRET=change-me-webhook-secret
