{
  "info": {
    "name": "Tripora API",
    "description": "Tripora backend API — V1 (Auth + User Profile + Destination + Travel Guide). Import together with tripora-api.postman_environment.json.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "accessToken", "value": "", "type": "string" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"traveler@tripora.dev\",\n  \"password\": \"password123\",\n  \"firstName\": \"Trip\",\n  \"lastName\": \"Traveler\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "register"]
            },
            "description": "Creates a new User (role USER). Sets refreshToken as an HTTP-Only cookie. 409 if the email is already registered."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201 || pm.response.code === 200) {",
                  "  const json = pm.response.json();",
                  "  if (json.accessToken) pm.collectionVariables.set('accessToken', json.accessToken);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"traveler@tripora.dev\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            },
            "description": "Sets refreshToken as an HTTP-Only cookie. 401 if email/password is wrong."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const json = pm.response.json();",
                  "  if (json.accessToken) pm.collectionVariables.set('accessToken', json.accessToken);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Refresh",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/auth/refresh",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "refresh"]
            },
            "description": "Reads refreshToken from the HTTP-Only cookie (Postman keeps cookies automatically after Login). Rotates the refresh token and returns a new accessToken. 401 if missing/expired/revoked."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const json = pm.response.json();",
                  "  if (json.accessToken) pm.collectionVariables.set('accessToken', json.accessToken);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/auth/logout",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "logout"]
            },
            "description": "Revokes the current refreshToken and clears the cookie."
          }
        }
      ]
    },
    {
      "name": "User",
      "item": [
        {
          "name": "Get Me",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/users/me",
              "host": ["{{baseUrl}}"],
              "path": ["users", "me"]
            },
            "description": "Requires Authorization: Bearer <accessToken>. 401 if missing/expired token."
          }
        },
        {
          "name": "Update Me",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"Trip\",\n  \"lastName\": \"Updated\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/users/me",
              "host": ["{{baseUrl}}"],
              "path": ["users", "me"]
            }
          }
        }
      ]
    },
    {
      "name": "Destination",
      "item": [
        {
          "name": "List Destinations",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/destinations?page=1&limit=20",
              "host": ["{{baseUrl}}"],
              "path": ["destinations"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "20" },
                { "key": "q", "value": "", "disabled": true },
                { "key": "country", "value": "", "disabled": true }
              ]
            },
            "description": "Public. Filter bằng q (contains name) / country. Trả { items, pagination }."
          }
        },
        {
          "name": "Get Destination by Slug",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/destinations/:slug",
              "host": ["{{baseUrl}}"],
              "path": ["destinations", ":slug"],
              "variable": [{ "key": "slug", "value": "da-nang" }]
            },
            "description": "Public. 404 nếu không tồn tại/đã xoá."
          }
        },
        {
          "name": "Create Destination",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Đà Nẵng\",\n  \"country\": \"Việt Nam\",\n  \"description\": \"Thành phố biển miền Trung.\",\n  \"images\": [\"https://picsum.photos/seed/tripora-danang/800/600\"],\n  \"tags\": [\"beach\", \"food\"]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/destinations",
              "host": ["{{baseUrl}}"],
              "path": ["destinations"]
            },
            "description": "Yêu cầu role ADMIN. `slug` tự sinh + dedup từ `name`."
          }
        },
        {
          "name": "Update Destination",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"description\": \"Cập nhật mô tả.\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/destinations/:id",
              "host": ["{{baseUrl}}"],
              "path": ["destinations", ":id"],
              "variable": [{ "key": "id", "value": "1" }]
            },
            "description": "Yêu cầu role ADMIN."
          }
        },
        {
          "name": "Delete Destination",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/destinations/:id",
              "host": ["{{baseUrl}}"],
              "path": ["destinations", ":id"],
              "variable": [{ "key": "id", "value": "1" }]
            },
            "description": "Yêu cầu role ADMIN. Soft delete (204 No Content)."
          }
        }
      ]
    },
    {
      "name": "Travel Guide",
      "item": [
        {
          "name": "List Travel Guides",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/travel-guides?page=1&limit=20",
              "host": ["{{baseUrl}}"],
              "path": ["travel-guides"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "20" },
                { "key": "q", "value": "", "disabled": true }
              ]
            },
            "description": "Public. Filter bang q (contains title). Tra { items, pagination }."
          }
        },
        {
          "name": "Get Travel Guide by Slug",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/travel-guides/:slug",
              "host": ["{{baseUrl}}"],
              "path": ["travel-guides", ":slug"],
              "variable": [{ "key": "slug", "value": "an-gi-o-da-nang" }]
            },
            "description": "Public. 404 neu khong ton tai/da xoa."
          }
        },
        {
          "name": "Create Travel Guide",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"An gi o Da Nang\",\n  \"excerpt\": \"Danh sach mon ngon khong the bo lo.\",\n  \"content\": \"Noi dung day du cua bai cam nang...\",\n  \"coverImage\": \"https://picsum.photos/seed/tripora-guide-danang/800/500\",\n  \"destinationId\": \"1\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/travel-guides",
              "host": ["{{baseUrl}}"],
              "path": ["travel-guides"]
            },
            "description": "Yeu cau role ADMIN. `slug` tu sinh + dedup tu `title`. `destinationId` khong bat buoc, 400 neu Destination khong ton tai."
          }
        },
        {
          "name": "Update Travel Guide",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"excerpt\": \"Cap nhat mo ta ngan.\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/travel-guides/:id",
              "host": ["{{baseUrl}}"],
              "path": ["travel-guides", ":id"],
              "variable": [{ "key": "id", "value": "1" }]
            },
            "description": "Yeu cau role ADMIN."
          }
        },
        {
          "name": "Delete Travel Guide",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/travel-guides/:id",
              "host": ["{{baseUrl}}"],
              "path": ["travel-guides", ":id"],
              "variable": [{ "key": "id", "value": "1" }]
            },
            "description": "Yeu cau role ADMIN. Soft delete (204 No Content)."
          }
        }
      ]
    }
  ]
}
