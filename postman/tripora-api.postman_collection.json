          }
        },
        {
          "name": "Delete Destination",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/destinations/:id",
              "host": ["{{baseUrl}}"],
              "path": ["destinations", ":id"],
              "variable": [{ "key": "id", "value": "1" }]
            },
            "description": "Yêu cầu role ADMIN. Soft delete (204 No Content)."
          }
        }
      ]
    },
