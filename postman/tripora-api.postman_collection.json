{
  "info": {
    "name": "Tripora API",
    "description": "Endpoint thật đã triển khai ở backend/ — khớp 1-1 với .claude/api-spec.md. Chọn environment \"Tripora Local\" trước khi chạy (chứa baseUrl + tài khoản dev seed từ prisma/seed.ts + paymentWebhookSecret). Chạy theo thứ tự: Auth > Destination > Property > Room > Room Availability > Booking > Payment > Refund để các biến {{...Id}}/{{...AccessToken}} được tự set qua Test/Pre-request script.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5550/api/v1" },
    { "key": "adminAccessToken", "value": "" },
    { "key": "partnerAccessToken", "value": "" },
    { "key": "travelerAccessToken", "value": "" },
    { "key": "destinationId", "value": "" },
    { "key": "newDestinationId", "value": "" },
    { "key": "propertyId", "value": "" },
    { "key": "deletablePropertyId", "value": "" },
    { "key": "roomId", "value": "" },
    { "key": "deletableRoomId", "value": "" },
    { "key": "roomAvailabilityId", "value": "" },
    { "key": "bookingId", "value": "" },
    { "key": "webhookTransactionId", "value": "" },
    { "key": "refundId", "value": "" },
    { "key": "newPartnerTravelerToken", "value": "" },
    { "key": "newPartnerId", "value": "" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201', () => pm.response.to.have.status(201));",
                  "const json = pm.response.json();",
                  "if (json.success && json.data && json.data.accessToken) {",
                  "  pm.collectionVariables.set('travelerAccessToken', json.data.accessToken);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{$randomEmail}}\",\n  \"password\": \"Passw0rd!\",\n  \"firstName\": \"New\",\n  \"lastName\": \"Traveler\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/register", "host": ["{{baseUrl}}"], "path": ["auth", "register"] },
            "description": "Đăng ký user mới, role mặc định TRAVELER — dùng {{$randomEmail}} (biến động Postman) để chạy lại nhiều lần không bị 409. Lưu accessToken vào travelerAccessToken, dùng cho folder Booking."
          },
          "response": []
        },
        {
          "name": "Login (Admin)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "if (json.success && json.data && json.data.accessToken) {",
                  "  pm.collectionVariables.set('adminAccessToken', json.data.accessToken);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] },
            "description": "Đăng nhập tài khoản Admin (seed sẵn qua prisma/seed.ts). Lưu accessToken vào biến collection adminAccessToken."
          },
          "response": []
        },
        {
          "name": "Login (Partner)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "if (json.success && json.data && json.data.accessToken) {",
                  "  pm.collectionVariables.set('partnerAccessToken', json.data.accessToken);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{partnerEmail}}\",\n  \"password\": \"{{partnerPassword}}\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] },
            "description": "Đăng nhập tài khoản Partner (seed sẵn, đã có hồ sơ Partner VERIFIED). Lưu accessToken vào biến collection partnerAccessToken."
          },
          "response": []
        },
        {
          "name": "Refresh",
          "request": {
            "method": "POST",
            "header": [],
            "url": { "raw": "{{baseUrl}}/auth/refresh", "host": ["{{baseUrl}}"], "path": ["auth", "refresh"] },
            "description": "Đọc refreshToken từ Cookie HTTP-Only do Login set trước đó (chạy trong cùng 1 phiên Postman đã bật lưu cookie)."
          },
          "response": []
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [],
            "url": { "raw": "{{baseUrl}}/auth/logout", "host": ["{{baseUrl}}"], "path": ["auth", "logout"] },
            "description": "Revoke refreshToken hiện tại (đọc từ Cookie)."
          },
          "response": []
        }
      ]
    },
    {
      "name": "User",
      "item": [
        {
          "name": "Get Me",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{adminAccessToken}}", "type": "string" }] },
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/users/me", "host": ["{{baseUrl}}"], "path": ["users", "me"] },
            "description": "Lấy profile của chính user đang đăng nhập (đổi Bearer Token sang partnerAccessToken nếu muốn test Partner)."
          },
          "response": []
        },
        {
          "name": "Update Me",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{adminAccessToken}}", "type": "string" }] },
