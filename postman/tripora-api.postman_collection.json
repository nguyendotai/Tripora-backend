    {
      "name": "Payment",
      "item": [
        {
          "name": "Confirm Payment (Webhook Success)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const bookingId = pm.collectionVariables.get('bookingId');",
                  "const amount = pm.collectionVariables.get('bookingTotal');",
                  "const transactionId = 'TXN-' + Date.now();",
                  "const secret = pm.environment.get('paymentWebhookSecret');",
                  "const payload = `${bookingId}.${transactionId}.${amount}.SUCCESS`;",
                  "const signature = CryptoJS.HmacSHA256(payload, secret).toString();",
                  "pm.collectionVariables.set('webhookTransactionId', transactionId);",
                  "pm.collectionVariables.set('webhookSignature', signature);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('Status is 200', () => pm.response.to.have.status(200));"]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"bookingId\": \"{{bookingId}}\",\n  \"transactionId\": \"{{webhookTransactionId}}\",\n  \"provider\": \"postman-test\",\n  \"amount\": {{bookingTotal}},\n  \"status\": \"SUCCESS\",\n  \"signature\": \"{{webhookSignature}}\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/payments/webhook", "host": ["{{baseUrl}}"], "path": ["payments", "webhook"] },
            "description": "Placeholder giả lập callback Gateway thật (chưa tích hợp VNPAY/Momo/Stripe). Không dùng JWT — xác thực bằng chữ ký HMAC-SHA256 (Pre-request script tự tính, cần biến environment paymentWebhookSecret khớp PAYMENT_WEBHOOK_SECRET ở backend/.env). SUCCESS -> Booking CONFIRMED/PAID. 400 nếu amount không khớp Payment.amount hoặc Booking không còn ở trạng thái chờ thanh toán."
          },
          "response": []
        }
      ]
    },
