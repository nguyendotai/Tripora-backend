            "body": { "mode": "raw", "raw": "{\n  \"firstName\": \"Tripora\",\n  \"lastName\": \"Admin\"\n}" },
            "url": { "raw": "{{baseUrl}}/users/me", "host": ["{{baseUrl}}"], "path": ["users", "me"] }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Destination",
      "item": [
        {
          "name": "List Destinations",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/destinations?page=1&limit=20",
              "host": ["{{baseUrl}}"],
              "path": ["destinations"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "20" },
                { "key": "q", "value": "", "disabled": true },
                { "key": "country", "value": "", "disabled": true }
              ]
            },
            "description": "Public — trả items + pagination."
          },
          "response": []
        },
        {
          "name": "Get Destination by Slug",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "if (json.success && json.data && json.data.id) {",
                  "  pm.collectionVariables.set('destinationId', json.data.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/destinations/da-nang", "host": ["{{baseUrl}}"], "path": ["destinations", "da-nang"] },
            "description": "Public. Đổi slug theo dữ liệu seed thật (vd: da-nang, hoi-an, phu-quoc, sa-pa, da-lat). Lưu id vào biến collection destinationId — dùng làm destinationId hợp lệ, ổn định (không bị xoá) cho các request Property bên dưới."
          },
          "response": []
        },
        {
          "name": "Create Destination (Admin)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201', () => pm.response.to.have.status(201));",
                  "const json = pm.response.json();",
                  "if (json.success && json.data && json.data.id) {",
                  "  pm.collectionVariables.set('newDestinationId', json.data.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{adminAccessToken}}", "type": "string" }] },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Nha Trang\",\n  \"country\": \"Vietnam\",\n  \"tags\": [\"beach\", \"diving\"]\n}"
            },
            "url": { "raw": "{{baseUrl}}/destinations", "host": ["{{baseUrl}}"], "path": ["destinations"] },
            "description": "Cần chạy Login (Admin) trước. Lưu id vào biến collection newDestinationId (tách riêng khỏi destinationId ở trên vì destination này sẽ bị xoá ở request Delete bên dưới, không nên dùng làm destinationId cho Property)."
          },
          "response": []
        },
        {
          "name": "Update Destination (Admin)",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{adminAccessToken}}", "type": "string" }] },
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"description\": \"Thanh pho bien noi tieng\"\n}" },
            "url": { "raw": "{{baseUrl}}/destinations/{{newDestinationId}}", "host": ["{{baseUrl}}"], "path": ["destinations", "{{newDestinationId}}"] }
          },
          "response": []
        },
        {
          "name": "Delete Destination (Admin)",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{adminAccessToken}}", "type": "string" }] },
            "method": "DELETE",
            "header": [],
            "url": { "raw": "{{baseUrl}}/destinations/{{newDestinationId}}", "host": ["{{baseUrl}}"], "path": ["destinations", "{{newDestinationId}}"] },
            "description": "400 nếu newDestinationId còn Property/Product active tham chiếu."
          },
          "response": []
        }
      ]
    },
